{
  "cli": {
    "version": ">= 15.0.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "bun": "1.3.14",
      "developmentClient": true,
      "distribution": "internal",
      "env": {
        "EXPO_PUBLIC_SHOW_TEST_ADS": "true",
        "REACT_NATIVE_NODE_BINARY": "node",
        "NODE_BINARY": "node"
      },
      "ios": {
        "simulator": true
      }
    },
    "preview": {
      "bun": "1.3.14",
      "distribution": "internal",
      "channel": "preview",
      "env": {
        "EXPO_PUBLIC_SHOW_TEST_ADS": "true",
        "REACT_NATIVE_NODE_BINARY": "node",
        "NODE_BINARY": "node"
      },
      "android": {
        "buildType": "apk"
      }
    },
    "production": {
      "autoIncrement": true,
      "bun": "1.3.14",
      "channel": "production",
      "env": {
        "EXPO_PUBLIC_SHOW_TEST_ADS": "false",
        "REACT_NATIVE_NODE_BINARY": "node",
        "NODE_BINARY": "node"
      },
      "android": {
        "buildType": "app-bundle"
      }
    }
  },
  "submit": {
    "production": {}
  }
}
