# Sentry Configuration (Optional for local builds; required if uploading sourcemaps locally)
# SENTRY_AUTH_TOKEN=your_sentry_auth_token_here
# SENTRY_DISABLE_AUTO_UPLOAD=true

# OpenPanel Analytics (Optional)
# EXPO_PUBLIC_OPENPANEL_CLIENT_ID=your_openpanel_client_id
# EXPO_PUBLIC_OPENPANEL_API_URL=https://openpanel.gventureshq.com/api

# Test Ads Flag (true/false). Development and preview stay true.
# Production must be false, or the binary embeds Google's demo App ID.
# EXPO_PUBLIC_SHOW_TEST_ADS=true

# AdMob Android. Copy from the AdMob app you already created.
# App ID looks like ca-app-pub-2441210659621996~XXXXXXXXXX (tilde).
# Banner unit looks like ca-app-pub-2441210659621996/XXXXXXXXXX (slash).
# Required on the Expo production environment before a production Android build.
# EXPO_PUBLIC_ADMOB_ANDROID_APP_ID=
# EXPO_PUBLIC_ADMOB_BANNER_ANDROID=

# AdMob iOS. Leave unset until an Apple Developer account exists.
# EXPO_PUBLIC_ADMOB_IOS_APP_ID=

# RevenueCat / Stripe Web Billing
# EXPO_PUBLIC_REVENUECAT_API_KEY_ANDROID=revenue_cat_api
# EXPO_PUBLIC_REVENUECAT_API_KEY_IOS=revenue_cat_api
# EXPO_PUBLIC_REVENUECAT_API_KEY_WEB=rcb_live_... (or sandbox rcb_sb_...)
# EXPO_PUBLIC_STRIPE_PORTAL_URL=https://billing.stripe.com/p/login/...
