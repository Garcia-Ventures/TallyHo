{
  "name": "tally-ho",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "ios": "expo start --ios",
    "android": "expo start --android",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "build:ios:sim": "eas build --platform ios --profile development",
    "build:ios:device": "eas build --platform ios --profile preview",
    "build:ios:store": "eas build --platform ios --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:play": "eas build --platform android --profile production",
    "test": "bun test",
    "build": "tsc && vite build",
    "dev": "vite",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:report": "eslint . --cache -o ./eslintReport.html -f html",
    "validate": "bun run ./scripts/validate.mjs",
    "validate:fix": "bun run ./scripts/validate.mjs --fix",
    "prepare": "husky",
    "preview": "vite preview"
  },
  "dependencies": {
    "@gv-tech/design-tokens": "^2.26.1",
    "@gv-tech/ui-web": "^2.26.1",
    "canvas-confetti": "^1.9.4",
    "chalk": "4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "^57.0.9",
    "expo-av": "^16.0.8",
    "expo-haptics": "^57.0.1",
    "expo-router": "^57.0.9",
    "lightningcss": "1.29.1",
    "lucide-react": "^0.475.0",
    "nativewind": "^5.0.0-preview.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-css": "^3.0.1",
    "react-native-reanimated": "4.5.1",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eng618/prettier-config": "^2.10.1",
    "@gv-tech/eslint-config": "^0.1.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^10.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "chalk": "4.1.2",
    "lightningcss": "1.29.1"
  },
  "resolutions": {
    "chalk": "4.1.2",
    "lightningcss": "1.29.1"
  },
  "private": true,
  "lint-staged": {
    "*.(js|ts|mjs|cjs)?(x)": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.(md)?(x)": [
      "prettier --write"
    ]
  },
  "prettier": "@eng618/prettier-config"
}
