{
  "name": "tally-ho",
  "version": "1.4.2",
  "private": true,
  "type": "module",
  "main": "expo-router/entry",
  "scripts": {
    "android": "expo run:android",
    "build": "tsc && expo export -p web",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:local": "SENTRY_DOTENV_PATH=\"${SENTRY_DOTENV_PATH:-.env.local}\" eas build --platform android --profile production --local --output ./build/production.aab",
    "build:android:local:apk": "SENTRY_DOTENV_PATH=\"${SENTRY_DOTENV_PATH:-.env.local}\" eas build --platform android --profile preview --local --output ./build/preview.apk",
    "build:android:local:submit": "SENTRY_DOTENV_PATH=\"${SENTRY_DOTENV_PATH:-.env.local}\" eas build --platform android --profile production --local --output ./build/production.aab && eas submit --platform android --profile production --path ./build/production.aab",
    "build:android:play": "eas build --platform android --profile production",
    "build:ios:device": "eas build --platform ios --profile preview",
    "build:ios:sim": "eas build --platform ios --profile development",
    "build:ios:store": "eas build --platform ios --profile production",
    "capture:android": "./scripts/capture-adb-screenshots.sh",
    "changelog": "node ./scripts/release-notes.mjs",
    "clean": "rm -rf node_modules .expo .vite bun.lock",
    "clean:cache": "rm -rf .expo node_modules/.cache",
    "dev": "expo start --web",
    "fingerprint": "node_modules/.bin/fingerprint fingerprint:generate",
    "fingerprint:check": "node ./scripts/fingerprint-diff.mjs --platform android --json",
    "fingerprint:diff": "node ./scripts/fingerprint-diff.mjs --json",
    "format": "oxfmt --write .",
    "format:ci": "oxfmt --check .",
    "ios": "expo run:ios",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "prepare": "husky",
    "quota:check": "node ./scripts/eas-build-safe.mjs --check-quota --platform android",
    "quota:status": "node ./scripts/eas-quota.mjs --platform all --summary",
    "reset": "bun run clean && bun install",
    "start": "expo start",
    "start:clean": "expo start -c",
    "submit:android": "eas submit --platform android --profile production",
    "submit:android:latest": "eas submit --platform android --profile production --latest",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest",
    "update:preview": "eas update --branch preview --clear-cache",
    "update:production": "eas update --branch production --clear-cache",
    "validate": "bun run ./scripts/validate.mjs",
    "validate:ci": "bun run ./scripts/validate.mjs --ci",
    "validate:coverage": "bun run ./scripts/validate.mjs --coverage",
    "validate:e2e": "bun run ./scripts/validate.mjs --maestro",
    "validate:fix": "bun run ./scripts/validate.mjs --fix",
    "validate:full": "bun run ./scripts/validate.mjs --full",
    "version:bump": "node ./scripts/bump-version.mjs",
    "version:major": "node ./scripts/bump-version.mjs major",
    "version:minor": "node ./scripts/bump-version.mjs minor",
    "version:patch": "node ./scripts/bump-version.mjs patch",
    "web": "expo start --web"
  },
  "dependencies": {
    "@gv-tech/design-tokens": "^2.28.0",
    "@gv-tech/ui-native": "^2.28.0",
    "@openpanel/react-native": "^1.4.1",
    "@openpanel/web": "^1.4.1",
    "@react-native-async-storage/async-storage": "^3.1.1",
    "@react-native-community/netinfo": "^12.0.1",
    "@revenuecat/purchases-js": "^1.59.0",
    "@sentry/react-native": "~8.25.0",
    "canvas-confetti": "^1.9.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.21",
    "expo-application": "~57.0.2",
    "expo-asset": "~57.0.16",
    "expo-audio": "~57.0.4",
    "expo-constants": "~57.0.17",
    "expo-dev-client": "~57.0.18",
    "expo-haptics": "^57.0.2",
    "expo-linking": "~57.0.9",
    "expo-router": "~57.0.20",
    "expo-splash-screen": "~57.0.8",
    "expo-updates": "~57.0.21",
    "lightningcss": "1.30.1",
    "lucide-react": "^1.43.0",
    "lucide-react-native": "^1.43.0",
    "nativewind": "^5.0.0-preview.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-native": "^0.86.2",
    "react-native-css": "^3.0.1",
    "react-native-purchases": "^10.7.1",
    "react-native-purchases-ui": "^10.8.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.5",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.10.1",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@gv-tech/oxc-config": "^0.1.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/react": "^16.3.3",
    "@testing-library/react-hooks": "^8.0.1",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "@vitest/coverage-v8": "^5.0.0",
    "autoprefixer": "^10.5.5",
    "babel-preset-expo": "^57.0.11",
    "husky": "^9.1.7",
    "jsdom": "^30.0.1",
    "lint-staged": "^17.5.0",
    "oxfmt": "^0.67.0",
    "oxlint": "^1.82.0",
    "oxlint-tsgolint": "^7.0.2001",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^8.2.1",
    "vitest": "^5.0.0"
  },
  "resolutions": {
    "lightningcss": "1.30.1"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "lint-staged": {
    "*.{js,jsx,ts,tsx,mjs,cjs,mts,cts}": [
      "oxfmt --write",
      "oxlint --fix"
    ],
    "*.{json,jsonc,md,yml,yaml}": [
      "oxfmt --write"
    ]
  }
}
