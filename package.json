{
  "name": "tally-ho",
  "version": "1.0.0",
  "main": "expo-router/entry",
  "type": "module",
  "scripts": {
    "start": "expo start",
    "start:clean": "expo start -c",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "web": "expo start --web",
    "prebuild": "expo prebuild",
    "prebuild:clean": "expo prebuild --clean",
    "clean": "rm -rf node_modules .expo .vite .eslintcache bun.lock",
    "clean:cache": "rm -rf .expo node_modules/.cache",
    "reset": "bun run clean && bun install",
    "build:ios:sim": "eas build --platform ios --profile development",
    "build:ios:device": "eas build --platform ios --profile preview",
    "build:ios:store": "eas build --platform ios --profile production",
    "build:android:apk": "eas build --platform android --profile preview",
    "build:android:play": "eas build --platform android --profile production",
    "test": "bun test",
    "build": "tsc && expo export -p web",
    "dev": "expo start --web",
    "format": "prettier --write .",
    "format:ci": "prettier --check .",
    "lint": "eslint . --cache",
    "lint:fix": "eslint . --cache --fix",
    "lint:report": "eslint . --cache -o ./eslintReport.html -f html",
    "validate": "bun run ./scripts/validate.mjs",
    "validate:fix": "bun run ./scripts/validate.mjs --fix",
    "capture:android": "./scripts/capture-adb-screenshots.sh",
    "prepare": "husky"
  },
  "dependencies": {
    "@gv-tech/design-tokens": "^2.27.3",
    "@gv-tech/ui-native": "^2.27.3",
    "@sentry/react-native": "~7.11.0",
    "canvas-confetti": "^1.9.4",
    "chalk": "4.1.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "expo": "~57.0.12",
    "expo-asset": "~57.0.10",
    "expo-audio": "~57.0.3",
    "expo-constants": "~57.0.10",
    "expo-haptics": "^57.0.1",
    "expo-linking": "~57.0.5",
    "expo-router": "~57.0.12",
    "expo-updates": "~57.0.13",
    "lightningcss": "1.29.1",
    "lucide-react": "^0.475.0",
    "lucide-react-native": "^0.475.0",
    "nativewind": "^5.0.0-preview.4",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "^0.86.2",
    "react-native-css": "^3.0.1",
    "react-native-reanimated": "4.5.1",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-svg": "15.15.4",
    "react-native-web": "^0.21.2",
    "react-native-worklets": "0.11.3",
    "tailwind-merge": "^3.0.1",
    "zustand": "^5.0.14"
  },
  "devDependencies": {
    "@eng618/prettier-config": "^2.10.2",
    "@gv-tech/eslint-config": "^0.1.14",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/canvas-confetti": "^1.9.0",
    "@types/node": "^22.13.4",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@vitejs/plugin-react": "^4.3.4",
    "autoprefixer": "^10.4.20",
    "babel-preset-expo": "^57.0.5",
    "eslint": "^10.8.1",
    "husky": "^9.1.7",
    "lint-staged": "^17.2.0",
    "postcss": "^8.5.2",
    "prettier": "^3.9.6",
    "tailwindcss": "^4.3.3",
    "typescript": "^6.0.3",
    "vite": "^6.1.0",
    "vitest": "^4.1.10"
  },
  "overrides": {
    "chalk": "4.1.2",
    "lightningcss": "1.29.1",
    "expo-asset": "~57.0.10",
    "expo-constants": "~57.0.10"
  },
  "resolutions": {
    "chalk": "4.1.2",
    "lightningcss": "1.29.1",
    "expo-asset": "~57.0.10",
    "expo-constants": "~57.0.10"
  },
  "private": true,
  "lint-staged": {
    "*.(js|ts|mjs|cjs)?(x)": [
      "prettier --write",
      "eslint --cache --fix"
    ],
    "*.(md)?(x)": [
      "prettier --write"
    ]
  },
  "prettier": "@eng618/prettier-config"
}
