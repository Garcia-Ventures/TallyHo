{
  "expo": {
    "name": "TallyHo",
    "slug": "tallyho",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.garciaventures.tallyho"
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FDFBF7"
      },
      "package": "com.garciaventures.tallyho",
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "bundler": "metro"
    },
    "plugins": [
      "expo-router",
      "expo-audio",
      [
        "@sentry/react-native/expo",
        {
          "url": "https://sentry.io/",
          "project": "react-native",
          "organization": "garcia-ventures"
        }
      ]
    ],
    "scheme": "tallyho",
    "extra": {
      "router": {},
      "eas": {
        "projectId": "ce9f1e2a-8d51-47e7-a6eb-4baf66646574"
      }
    },
    "owner": "gvtech"
  }
}
